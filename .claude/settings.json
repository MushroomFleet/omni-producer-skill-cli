{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin main)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git rev-parse*)",
      "Bash(dotnet publish *)",
      "Bash(dotnet --version)",
      "Bash(pwsh *)",
      "Bash(Copy-Item *)",
      "Bash(Get-FileHash *)",
      "Bash(omni-producer/OmniProducer.exe * -DryRun*)",
      "Bash(gh release view *)",
      "Bash(gh auth status*)"
    ],
    "deny": [
      "Bash(gh release create *)",
      "Bash(gh release upload *)",
      "Bash(gh release delete *)",
      "Bash(git push --tags*)",
      "Bash(git push origin v*)",
      "Bash(git tag *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  }
}
