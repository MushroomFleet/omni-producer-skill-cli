<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OmniProducer</RootNamespace>
    <AssemblyName>OmniProducer</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyTitle>Omni Producer</AssemblyTitle>
    <Product>Omni Producer</Product>
    <Description>Zero-UI CLI for the Gemini Omni Flash video generation/editing API</Description>
    <Version>1.0.3</Version>
  </PropertyGroup>

</Project>
